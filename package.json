{
  "name": "routeconnect-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "dev": "vite",
    "dev:all": "concurrently -k -n server,vite \"npm run server\" \"npm run dev\"",
    "build": "tsc && vite build",
    "render:build": "npm run build && npm run transit:ensure",
    "preview": "vite preview",
    "test": "node --test \"backend/**/*.test.js\" \"src/**/*.test.js\"",
    "transit:download": "node backend/transit/cli/download.js",
    "transit:validate": "node backend/transit/cli/validate.js",
    "transit:import": "node backend/transit/cli/import.js",
    "transit:compare": "node backend/transit/cli/compare.js",
    "transit:ensure": "node backend/transit/cli/ensure.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/react-router-dom": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
