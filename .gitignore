backend/transit/data/
backend/transit/reports/
backend/data/
*.zip

# Build output
dist/
*.tsbuildinfo

# Local scratch / experiments
scratch/

# Logs and temporary files
*.log
npm-debug.log*
.vite/
coverage/
.DS_Store
Thumbs.db
