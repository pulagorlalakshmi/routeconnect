PORT=5000

# Restrict this server-side key to Routes API, Places API (New), and Geocoding API.
GOOGLE_MAPS_SERVER_API_KEY=your_server_restricted_google_maps_api_key

# Duffel flight search token. Keep this server-side; never expose it to Vite.
DUFFEL_ACCESS_TOKEN=your_duffel_access_token

# --- User/auth database (optional; defaults to ./routeconnect.db) ---
# ROUTECONNECT_DATABASE_PATH=./routeconnect.db

# --- Transit data pipeline (optional; defaults shown) ---
# The transit database is separate from the user database and is generated by "npm run transit:import".
# ROUTECONNECT_TRANSIT_DATABASE_PATH=./backend/transit/data/transit.db
# Community-maintained GTFS feed, local prototype use only (licence unconfirmed; do not commit or redistribute).
# ROUTECONNECT_GTFS_URL=https://github.com/Neo2308/apsrtc-gtfs/raw/refs/heads/main/gtfs/gtfs.zip
# ROUTECONNECT_GTFS_ZIP_PATH=./backend/transit/data/feeds/apsrtc-gtfs.zip
# ROUTECONNECT_GTFS_SOURCE_NAME=Community APSRTC GTFS
# ROUTECONNECT_GTFS_LICENSE=unknown