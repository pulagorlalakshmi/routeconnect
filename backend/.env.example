PORT=5000

# Restrict this server-side key to Routes API, Places API (New), and Geocoding API.
GOOGLE_MAPS_SERVER_API_KEY=your_server_restricted_google_maps_api_key

# Duffel flight search token. Keep this server-side; never expose it to Vite.
DUFFEL_ACCESS_TOKEN=your_duffel_access_token

# --- User/auth database (optional; defaults to ./routeconnect.db) ---
# ROUTECONNECT_DATABASE_PATH=./routeconnect.db

# --- Transit data pipeline (optional; defaults shown) ---
# The transit database is separate from the user database and is generated by "npm run transit:ensure" (or transit:import).
# Both ./backend/transit/data/transit.db and ./backend/data/transit.db are supported automatically.
# On Render with a Persistent Disk mounted at /var/data, set:
# ROUTECONNECT_TRANSIT_DATABASE_PATH=/var/data/transit.db
# ROUTECONNECT_GTFS_ZIP_PATH=/var/data/feeds/apsrtc-gtfs.zip
# ROUTECONNECT_AUTO_IMPORT_TRANSIT=true
# ROUTECONNECT_TRANSIT_DATABASE_PATH=./backend/transit/data/transit.db
# Community-maintained GTFS feed, local prototype use only (licence unconfirmed; do not commit or redistribute).
# ROUTECONNECT_GTFS_URL=https://github.com/Neo2308/apsrtc-gtfs/raw/refs/heads/main/gtfs/gtfs.zip
# ROUTECONNECT_GTFS_ZIP_PATH=./backend/transit/data/feeds/apsrtc-gtfs.zip
# ROUTECONNECT_GTFS_SOURCE_NAME=Community APSRTC GTFS
# ROUTECONNECT_GTFS_LICENSE=unknown
# --- Railway timetable (optional; OFF by default) ---
# Train search stays off unless this is "true". The default rail feed is an UNOFFICIAL community export of the Indian
# Railways timetable with NO stated licence: enable it only after deciding that its use is acceptable for your deployment.
# See backend/transit/rail/README.md.
# ROUTECONNECT_RAIL_ENABLED=false
# ROUTECONNECT_RAIL_DATABASE_PATH=/var/data/rail.db
# ROUTECONNECT_RAIL_GTFS_URL=https://github.com/Neo2308/indianrailways-gtfs/raw/refs/heads/main/gtfs/gtfs.zip
# ROUTECONNECT_AUTO_IMPORT_RAIL=true
# ROUTECONNECT_RAIL_STALE_WARNING_DAYS=45
# ROUTECONNECT_RAIL_MAX_SNAPSHOT_AGE_DAYS=120
# ROUTECONNECT_RAIL_MIN_TRANSFER_MINUTES=45
# ROUTECONNECT_RAIL_MAX_TRANSFER_WAIT_MINUTES=180

# RailRadar: scheduled train search (server-side only; never exposed to Vite). With a key, "Train" searches RailRadar's
# date-specific timetable (one request per search, cached 6 h). Free plan: 100 requests/month for personal,
# non-commercial testing; a public launch needs a paid plan and a check of RailRadar's API terms.
# RAILRADAR_API_KEY=
# RAILRADAR_MONTHLY_REQUEST_BUDGET=100

# --- Estimated rail connections (mapped OpenStreetMap track + assumed speeds; NOT scheduled trains) ---
# Data © OpenStreetMap contributors (ODbL). Built by "npm run rail:network:ensure"; keep it on a persistent disk.
# ROUTECONNECT_RAIL_NETWORK_ENABLED=true
# ROUTECONNECT_RAIL_NETWORK_DIR=/var/data/railNetwork
# ROUTECONNECT_RAIL_NETWORK_REGIONS=Andhra Pradesh,Telangana
# Server start-up may fetch the one regional OSM extract itself when none exists yet; "false" forbids that.
# ROUTECONNECT_RAIL_NETWORK_AUTO_EXTRACT=true
